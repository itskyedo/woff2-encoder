{
  "name": "woff2-encoder",
  "version": "3.0.0-beta.1",
  "description": "A TypeScript library for handling WOFF2 encoding using WebAssembly",
  "author": "Kyedo <hey@kyedo.dev> (https://github.com/itskyedo)",
  "license": "MIT",
  "homepage": "https://github.com/itskyedo/woff2-encoder#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itskyedo/woff2-encoder.git"
  },
  "bugs": {
    "url": "https://github.com/itskyedo/woff2-encoder/issues"
  },
  "keywords": [
    "woff2",
    "ttf",
    "otf",
    "sfnt",
    "compress",
    "convert",
    "encode",
    "esm"
  ],
  "scripts": {
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "formatcheck": "pnpm format:check",
    "lint": "oxlint --deny-warnings .",
    "lintfix": "oxlint --fix .",
    "fix": "pnpm lintfix && pnpm format",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint && pnpm formatcheck",
    "test": "vitest",
    "test:e2e": "pnpm build && pnpm test:e2e:exports && playwright test",
    "test:e2e:exports": "node tests/e2e/package-exports.mjs",
    "test:e2e:install": "playwright install --with-deps chromium firefox webkit",
    "act:e2e": "node scripts/act.mjs e2e",
    "act:test": "node scripts/act.mjs",
    "commitlint": "commitlint",
    "build:wasm": "docker build --platform linux/amd64 -t woff2-encoder . && docker run --platform linux/amd64 --rm -v $(pwd):/src/woff2-encoder -u $(id -u):$(id -g) -it woff2-encoder make -C /src/woff2-encoder",
    "build": "tsdown"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./decompress": {
      "import": {
        "types": "./dist/decompress.d.mts",
        "default": "./dist/decompress.mjs"
      },
      "require": {
        "types": "./dist/decompress.d.cts",
        "default": "./dist/decompress.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">= 20.x"
  },
  "packageManager": "pnpm@10.28.2",
  "sideEffects": false,
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@playwright/test": "^1.59.1",
    "@vitest/coverage-v8": "^4.0.18",
    "lefthook": "^2.1.0",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "tsdown": "^0.20.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
