{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "bracketSameLine": true,
  "printWidth": 80,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "es5",
  "jsdocSpaces": 1,
  "sortPackageJson": false,
  "ignorePatterns": [
    "build/**",
    "coverage/**",
    "dist/**",
    "node_modules/**",
    ".pnpm-store/**",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSE-THIRD-PARTY",
    "*.html"
  ]
}
